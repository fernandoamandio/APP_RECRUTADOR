# Supabase (service role: só no servidor, nunca no app)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5

# Fontes de vagas
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Países consultados na Adzuna (códigos da API, separados por vírgula)
ADZUNA_COUNTRIES=gb,nl,de,us,ca
JOOBLE_API_KEY=
# InfoJobs (opcional): registre uma aplicação em developer.infojobs.net
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# Contato enviado no User-Agent das requisições (boa prática com APIs públicas)
CONTACT_EMAIL=contato@exemplo.com
