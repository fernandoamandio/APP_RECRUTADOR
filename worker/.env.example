# Supabase (service role: só no servidor, nunca no app)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# A IA (Claude ou ChatGPT), o modelo, a chave e o e-mail de contato são cadastrados por cada
# usuário no app (Perfil → Inteligência artificial) e ficam no Vault do Supabase.

# Fontes de vagas
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Países consultados na Adzuna (códigos da API, separados por vírgula)
ADZUNA_COUNTRIES=br,gb,nl,de,us,ca
JOOBLE_API_KEY=
# InfoJobs (opcional): registre uma aplicação em developer.infojobs.net
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# Opcional, USO PESSOAL: LinkedIn, Indeed e Glassdoor via Apify (raspagem; contra os termos desses sites)
APIFY_TOKEN=
APIFY_ACTOR=iskoren/multi-job-board-scraper
# Total por rodada: 1/4 no Brasil e 3/4 remotas em outros países (20 → 5 + 15)
APIFY_MAX_RESULTS=20
# APIFY_BR_RESULTS=5

# Opcional: contato no User-Agent quando nenhum usuário da rodada informou e-mail no app
CONTACT_EMAIL=
